# ReEscape Protocol environment example
# Copy this file to `.env` and fill in the values you actually use.
#
# Source of truth:
# - `.env`: process settings, feature switches, runtime limits, paths and selectors.
# - `config/ai_profiles.json`: active AI provider/model profiles and generation settings.
# - `config/character/*.json`: character cards selected by CHARACTER.
#
# Important: the mixed-case names below are required by the current Go loader.

# Connection and runtime selectors
HOSTADD=127.0.0.1
WsPort=3001
HttpPort=8088
Token=your_onebot_access_token
TARGETID=987654321
CHARACTER=default
ENV_FILE=.env

# Admin API security and runtime recovery
ADMIN_LISTEN_HOST=127.0.0.1
# Required for all /api/admin/* routes. Generate a long random value.
ADMIN_API_KEY=
ADMIN_CORS_ORIGINS=http://127.0.0.1:8088,http://localhost:8088,http://localhost:5173
ONEBOT_DIAL_TIMEOUT_MS=10000
ONEBOT_RECONNECT_INITIAL_MS=1000
ONEBOT_RECONNECT_MAX_MS=30000
ONEBOT_HEARTBEAT_INTERVAL_MS=15000
ONEBOT_READ_TIMEOUT_MS=45000
SHUTDOWN_TIMEOUT_MS=10000

# AI profile selection
AI_PROFILE=default
AI_CONFIG_FILE=./config/ai_profiles.json

# Optional AI bootstrap fallback
# Used only when the profile file is missing or a selected profile is created.
# After creating `config/ai_profiles.json`, edit that file instead.
AI_KEY=your_ai_api_key
AI_BASEURL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=1.0
AI_MAX_TOKENS=2000
AI_TIMEOUT=30
AI_RETRY_COUNT=3
AI_RATE_LIMIT=20
AI_TOP_P=0.9

# Prompt and character canon
AI_PROMPT=
ALLOW_CHARACTER_IDENTITY_EXPLANATION=false

# Context and multimodal input
ENABLE_TIME_CONTEXT=true
TIME_CONTEXT_TIMEZONE=Asia/Shanghai
TIME_CONTEXT_FORMAT=2006-01-02 15:04:05
ENABLE_VISION_INPUT=false
VISION_IMAGE_DETAIL=auto
ENABLE_IMAGE_OCR_FALLBACK=false
ENABLE_IMAGE_ASSET_REPLY=true
IMAGE_ASSET_DIR=./assets/images
IMAGE_ASSET_INDEX_FILE=./assets/images/index.json
ENABLE_SPACE_SEGMENT_DELIMITER=false
# `conservative`: 更容易不回/轻回；`balanced`: 折中；`reply_first`: 更倾向完整回复
CONTEXT_RECENT_TURNS=8
CONTEXT_SUMMARY_MAX_TURNS=24
CONTEXT_OPEN_LOOP_LIMIT=4

# ReAct runtime
ENABLE_REACT_AGENT=true
REACT_MAX_STEPS=4
REACT_TOOL_TIMEOUT_MS=3000
# Enable write tools such as remember_fact, update_profile, update_affection.
# When false, write tools are not exposed to the model.
REACT_ALLOW_WRITE_TOOLS=false
REACT_TRACE_MODE=basic
REACT_TOTAL_TIMEOUT_MS=30000

# ReAct web tools
ENABLE_WEB_TOOLS=false
WEB_SEARCH_PROVIDER=searxng
# For Tavily, WEB_SEARCH_ENDPOINT can be empty and defaults to its API endpoint.
WEB_SEARCH_ENDPOINT=http://127.0.0.1:8888/search
WEB_SEARCH_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
WEB_TOOL_TIMEOUT_MS=8000
TAVILY_SEARCH_DEPTH=basic
TAVILY_TOPIC=general
TAVILY_INCLUDE_ANSWER=false
TAVILY_INCLUDE_RAW_CONTENT=false
TAVILY_SAFE_SEARCH=false
WEB_FETCH_MAX_BYTES=1048576
WEB_FETCH_MAX_CHARS=6000
WEB_FETCH_USER_AGENT=ReEscapeProtocolBot/1.0

# Standard Agent Skills
ENABLE_SKILLS=true
SKILL_DIRS=./config/skills
SKILL_AUTO_HINT_LIMIT=3
SKILL_CANDIDATE_MIN_SCORE=8
SKILL_AUTO_LOAD_MIN_SCORE=16
SKILL_AUTO_LOAD_MIN_CONFIDENCE=0.75
SKILL_MAX_AUTO_LOADED=1
SKILL_FORCE_READ_ON_CANDIDATE=false
SKILL_RESOURCE_MAX_BYTES=65536
SKILL_ALLOW_SCRIPTS=false
SKILL_LOAD_SYSTEM=false

# Conversation scheduling and aggregation
ENABLE_NATURAL_SCHEDULER=true
ENABLE_EMOTIONAL_MEMORY=true
MESSAGE_AGGREGATE_IDLE_WINDOW_MS=2000
MESSAGE_AGGREGATE_MAX_WINDOW_MS=10000
MESSAGE_AGGREGATE_MAX_MESSAGES=5
ACTIVE_HOURS=9,10,11,14,15,16,19,20,21
SLEEP_HOURS=0,1,2,3,4,5,6,7,8,22,23
BASE_INTERVAL=45
RANDOM_FACTOR=0.5
PROACTIVE_CLAIM_LEASE_MS=120000
PROACTIVE_SKIP_ON_PENDING_USER=true
PROACTIVE_USER_MESSAGE_GRACE_MS=30000

# Logging, health and storage
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_FORMAT=text
LOG_ENABLE_COLOR=true
ENABLE_AI_RAW_LOG=false
REQUEST_ID_HEADER=X-Request-ID
ENABLE_HEALTH_ENDPOINT=true
ENABLE_METRICS=true
METRICS_PATH=/metrics
LOG_DIR=./logs
DATA_DIR=./data
